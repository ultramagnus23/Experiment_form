# ---- Required -------------------------------------------------------------
# Public URL of the app, no trailing slash. Used for sign-in links, cookie "Secure" flag and CSRF origin checks.
APP_URL=http://localhost:3000

# PostgreSQL connection string. (With docker compose this is assembled for you from POSTGRES_PASSWORD.)
DATABASE_URL=postgresql://experiment:change-me@localhost:5432/experiment
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Where uploaded audio is stored. MUST be on persistent storage (docker volume / mounted disk).
AUDIO_DIR=./data/audio

# ---- Administrators -------------------------------------------------------
# Comma-separated allowlist. If unset, the five researchers below are used.
ADMIN_EMAILS=akshita.sinha_ug2025@ashoka.edu.in,gunn.malhotra_ug2024@ashoka.edu.in,ishani.dhingra_ug2025@ashoka.edu.in,meenal.goel_ug2024@ashoka.edu.in,zitien.tickoo_ug2025@ashoka.edu.in

# ---- Email for magic-link sign-in (required in production) ----------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Research Dashboard <no-reply@example.com>"

# ---- Optional -------------------------------------------------------------
MAX_AUDIO_MB=30
# Public domain for the optional bundled HTTPS reverse proxy (docker compose --profile https up)
DOMAIN=experiment.example.com

# TESTING ONLY: write sign-in links to data/dev-outbox.log instead of emailing them.
# Never set this on a real deployment (anyone with file access could sign in).
# MAIL_TRANSPORT=file

# ---- Vercel + Neon + Blob (see docs/DEPLOY_VERCEL.md) ---------------------
# Injected by the Neon integration: DATABASE_URL (pooled, used by the app) and DATABASE_URL_UNPOOLED (used by migrations/backup).
# Injected by the Blob integration (private store): BLOB_READ_WRITE_TOKEN. When set, audio is stored in Blob instead of AUDIO_DIR.
# APP_URL must equal the exact URL participants/researchers use.
